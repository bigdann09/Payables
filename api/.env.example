# ---------------------------------------------------------------------------
# Payables API. Copy to .env. Every external integration is OPTIONAL: when its
# variables are missing the API logs "[MOCK] ..." at startup and uses a local fallback.
# ---------------------------------------------------------------------------

# --- Core (required; ports match the root docker-compose.yml) ---
PORT=4000
DATABASE_URL=postgresql://payables:payables@localhost:55432/payables
REDIS_URL=redis://localhost:56379
# Demo company id ("auth" for the hackathon); requests may override it with the x-company-id header.
COMPANY_ID=acme
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Used to build links (local signed PDF URLs, notification links).
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Demo knobs ---
# If set, scheduled payments run at min(dueDate, now + N seconds) instead of waiting for the due date.
PAY_DELAY_OVERRIDE_SECONDS=15
# How often to poll the contract for DAO-approved / rejected invoices (real chain only).
CHAIN_SYNC_INTERVAL_MS=15000

# --- Storage: Cloudflare R2 (S3 API). Missing => local disk + HMAC-signed /api/files URLs ---
R2_ACCOUNT_ID=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOCAL_STORAGE_DIR=.data/uploads
FILE_URL_SECRET=change-me

# --- Extraction: NEAR AI Cloud (OpenAI-compatible). Missing key => deterministic fake extractor ---
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# --- NEAR. Missing AGENT_PRIVATE_KEY => simulated policy contract (same rules, in memory) ---
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
POLICY_CONTRACT_ID=acme.payables.testnet
USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
DAO_ID=acme-dao.sputnik-v2.testnet
AGENT_ACCOUNT_ID=payables-agent.testnet
# Function-call access key limited to request_payment on POLICY_CONTRACT_ID, format ed25519:...
AGENT_PRIVATE_KEY=
# Owner full-access key: register_payee, set_limits, request_payee_change.
OWNER_ACCOUNT_ID=payables.testnet
OWNER_PRIVATE_KEY=
# Starting USDC balance of the simulated treasury (base units, 6 decimals) = 15 USDC, like the testnet treasury.
SIM_TREASURY_BALANCE=15000000
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/
ASTRODAO_URL=https://testnet.app.astrodao.com

# --- Notifications. Missing => printed to the console ---
TELEGRAM_BOT_TOKEN=
# Fallback chat id when the company has no telegramChatId set.
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
EMAIL_FROM=Payables <payables@example.com>
